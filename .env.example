# ---- Discord ----
DISCORD_TOKEN=your-bot-token
# Only messages in this channel are processed. Right-click channel > Copy Channel ID.
SUBMISSION_CHANNEL_ID=123456789012345678
# Every verification result (success, needs-review, unreadable, error) is also
# posted here. Optional - leave blank to not mirror anywhere.
VERIFICATION_LOG_CHANNEL_ID=
# Siege-composition check: its own channel, own screenshot type (Troop Details).
# Optional - leave blank to disable the siege check entirely.
SIEGE_CHECK_CHANNEL_ID=
# Optional: role that may run /hospital admin commands. Blank = server admins only.
ADMIN_ROLE_ID=

# ---- Anthropic (vision fallback) ----
ANTHROPIC_API_KEY=sk-ant-...
VISION_MODEL=claude-sonnet-5

# ---- Google Sheets ----
# Path to the service-account JSON key. Used when GOOGLE_CREDENTIALS_JSON
# (below) is not set.
GOOGLE_CREDENTIALS_FILE=service_account.json
# Alternative to the file above, for hosts with nowhere to put a file before
# the container starts (e.g. Railway): paste the entire key file's JSON
# content as one value here instead. Takes priority over
# GOOGLE_CREDENTIALS_FILE when both are set. Leave blank when running
# locally with the file.
GOOGLE_CREDENTIALS_JSON=
# The ID from the sheet URL: docs.google.com/spreadsheets/d/<THIS PART>/edit
SPREADSHEET_ID=your-google-sheet-id
ROSTER_TAB=Roster
SUBMISSIONS_TAB=Submissions
TROOPS_TAB=Troops
SIEGE_CHECK_TAB=SiegeCheck

# ---- Tesseract ----
# Windows default install path. Leave blank to use PATH.
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# ---- Behaviour ----
# Every submitted screenshot is kept here, named by governor ID and time. This is
# what makes a bad reading reproducible - without the actual file a misread
# cannot be diagnosed. Set to "off" to stop saving.
SAVE_SUBMISSIONS_DIR=submissions

# Minutes a partial submission stays open for follow-up screenshots.
SESSION_TIMEOUT_MINUTES=30

# How many screenshots get OCR'd at once. A submission reacts and downloads
# instantly either way; this only controls how many run the slow, CPU-bound
# reading step in parallel during a burst. 2 is reasonable for a single-core box.
SUBMISSION_WORKERS=2
